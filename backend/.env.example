PORT=5000
NODE_ENV=development
JWT_SECRET=jwt_token_here
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
CLINIC_NAME=VIORA
DATABASE_URL="file:./viora.db"

# WhatsApp Business API Configuration (Meta Cloud API)
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_permanent_access_token_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=viora_webhook_verify_token_2026

# VIORA Security & Link Expiry Policies
BILL_LINK_EXPIRY_DAYS=365
APP_BASE_URL=http://localhost:5173
