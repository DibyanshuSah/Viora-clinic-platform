{
  "name": "viora-backend",
  "version": "1.0.0",
  "description": "VIORA Clinic Management System - Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "db:backup": "node src/utils/backupCli.js create",
    "db:restore": "node src/utils/backupCli.js restore",
    "db:verify": "node src/utils/backupCli.js verify",
    "db:list": "node src/utils/backupCli.js list",
    "seed": "node prisma/seed.js",
    "test": "node test_complete_system.js",
    "test:concurrency": "node test_concurrency_ids.js",
    "test:invoice": "node test_invoice_lifecycle.js",
    "test:persistence": "node test_persistence_restart.js",
    "test:backup": "node test_backup_restore.js",
    "test:all": "node test_complete_system.js && node test_concurrency_ids.js && node test_invoice_lifecycle.js && node test_persistence_restart.js && node test_backup_restore.js"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "prisma": "5.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
