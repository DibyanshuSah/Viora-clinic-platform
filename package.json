{
  "name": "viora-clinic-management-system",
  "version": "1.0.0",
  "description": "VIORA Clinic Management System - Full-stack Healthcare Application",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "start": "npm --prefix backend start",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:migrate": "npm --prefix backend run prisma:migrate",
    "prisma:status": "npm --prefix backend run prisma:status",
    "db:backup": "npm --prefix backend run db:backup",
    "db:restore": "npm --prefix backend run db:restore",
    "seed": "npm --prefix backend run seed",
    "test": "npm --prefix backend run test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "viora",
    "clinic",
    "management",
    "healthcare",
    "react",
    "express"
  ],
  "author": "VIORA Healthcare Systems",
  "license": "ISC"
}
